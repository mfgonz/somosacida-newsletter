# Copy to .env.local for development. NEVER commit the filled-in file.

# ---- Supabase ----
# Project URL and publishable (anon) key are safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# Service role key bypasses Row Level Security. Server-only.
# Never prefix with NEXT_PUBLIC_ and never import into a client component.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# ---- Resend (email delivery) ----
RESEND_API_KEY="re_your_api_key"
# Verified sending identity. The domain must be verified in Resend with
# SPF + DKIM + DMARC records before any campaign will deliver reliably.
RESEND_FROM_EMAIL="hola@somosacida.com"
RESEND_FROM_NAME="Somos Ácida"
RESEND_REPLY_TO="hola@somosacida.com"
# Signing secret from the Resend webhook settings, used to verify inbound events.
RESEND_WEBHOOK_SECRET="whsec_your_webhook_secret"

# ---- Application ----
# Public origin, used to build unsubscribe/confirmation links. No trailing slash.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Only these email addresses may sign in to the admin dashboard.
# Comma-separated. Anyone else is rejected even with a valid Supabase session.
ADMIN_EMAIL_ALLOWLIST="mfgonzp@gmail.com"

# 32+ byte random secret for signing unsubscribe / preference-center tokens.
# Generate with: openssl rand -base64 48
TOKEN_SIGNING_SECRET="replace-me-with-a-long-random-string"

# Shared secret required by the scheduled-send cron endpoint.
# Generate with: openssl rand -base64 32
CRON_SECRET="replace-me-with-a-long-random-string"
